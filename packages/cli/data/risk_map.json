  "gpai": {
    "article": "51-56",
    "title": "General-Purpose AI Models (Chapter V)",
    "url": "https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401689#chapter-V",
    "enforcement_date": "2025-08-02",
    "categories": [
      {
        "id": "gpai_standard",
        "title": "GPAI Model - Standard Obligations",
        "article": "53",
        "description": "General-purpose AI models must comply with transparency and documentation obligations.",
        "obligations": [
          "Maintain and make available technical documentation (Article 53(1)(a))",
          "Provide information and documentation to downstream providers (Article 53(1)(b))",
          "Implement a copyright compliance policy (Article 53(1)(c))",
          "Publish a sufficiently detailed summary of training data content (Article 53(1)(d))"
        ],
        "patterns": [
          "general-purpose ai",
          "general purpose ai",
          "foundation model",
          "large language model",
          "llm provider",
          "pre-trained model",
          "base model",
          "multi-purpose ai"
        ],
        "examples": [
          "GPT-4 style large language model",
          "Foundation model for text and code generation"
        ]
      },
      {
        "id": "gpai_systemic",
        "title": "GPAI Model with Systemic Risk",
        "article": "55",
        "description": "GPAI models with systemic risk (>10^25 FLOPs training compute or equivalent) have additional obligations.",
        "obligations": [
          "Perform model evaluations, including adversarial testing (Article 55(1)(a))",
          "Assess and mitigate possible systemic risks (Article 55(1)(b))",
          "Track, document and report serious incidents to the AI Office (Article 55(1)(c))",
          "Ensure adequate cybersecurity protections (Article 55(1)(d))"
        ],
        "patterns": [
          "systemic risk",
          "frontier model",
          "large-scale ai model",
          "10^25 flops",
          "systemic ai"
        ],
        "examples": [
          "Frontier AI model exceeding 10^25 FLOPs compute threshold",
          "Multi-modal foundation model deployed at scale"
        ]
      }
    ]
