{
  "name": "legalithm-mcp-server",
  "version": "0.2.1",
  "description": "EU AI Act compliance MCP server for Claude Code, Cursor and Codex — classify risk, explain obligations, generate Article 50 disclosures. Offline, no API key.",
  "mcpName": "io.github.PedramMadani/legalithm-mcp-server",
  "type": "module",
  "bin": {
    "legalithm-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:mcpb": "npm run build && node scripts/build-mcpb.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "eu-ai-act",
    "ai-act",
    "compliance",
    "mcp",
    "model-context-protocol",
    "cursor",
    "claude-code",
    "codex",
    "legalithm",
    "ai-governance"
  ],
  "license": "MIT",
  "author": "Legalithm",
  "homepage": "https://www.legalithm.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legalithm-org/legalithm.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/legalithm-org/legalithm/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsup": "^8.0.0",
    "typescript": "^5"
  }
}
